# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public HTTPS origin in staging/production. Used for links and origin checks.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production/staging: PostgreSQL 14+ (verified on 16.4). Leave unset locally to
# use embedded PGlite at PGLITE_DIR (single-writer, development only).
# DATABASE_URL=postgres://user:password@host:5432/business_intelligence?sslmode=require
PGLITE_DIR=.data/pglite

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_TTL_DAYS=30
# Development only: expose verification/reset links in the UI. MUST be false in
# staging and production.
AUTH_DEV_EXPOSE_TOKENS=false

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# smtp  -> real delivery through SMTP_URL + EMAIL_FROM (required in production)
# file  -> writes JSON messages to MAIL_OUTBOX_DIR (development only)
# disabled -> fails safely; registration is refused in production
EMAIL_TRANSPORT=file
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Ledgerline <no-reply@example.com>"
MAIL_OUTBOX_DIR=.data/mail-outbox
EMAIL_MAX_ATTEMPTS=5
EMAIL_BACKOFF_SECONDS=60

# ---------------------------------------------------------------------------
# Private document storage
# ---------------------------------------------------------------------------
# local -> UPLOAD_DIR on a private persistent volume (single node)
# s3    -> private S3-compatible bucket; downloads always stream through the app
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760
# S3_BUCKET=
# S3_REGION=eu-west-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Malware scanning (ClamAV INSTREAM). When configured, uploads fail closed.
# ---------------------------------------------------------------------------
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000
# strict (default) rejects uploads when the configured scanner errors.
UPLOAD_SCAN_POLICY=strict

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Required to enable POST /api/jobs/run. Use a long random value.
# JOBS_SECRET=

# ---------------------------------------------------------------------------
# Demo
# ---------------------------------------------------------------------------
# Refuse `npm run db:seed` / `demo:reset` in production unless explicitly true.
SEED_DEMO_DATA=false
