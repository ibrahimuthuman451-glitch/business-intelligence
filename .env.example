# ---- Core ----
NODE_ENV=development
# Public origin used for links in emails and CSRF origin validation.
APP_URL=http://localhost:3000

# Production database (PostgreSQL 14+). If unset, the app uses an embedded
# PGlite database at PGLITE_DIR (suitable for local dev and tests only).
# DATABASE_URL=postgres://user:password@localhost:5432/business_intelligence
PGLITE_DIR=.data/pglite

# Private document storage. Never expose this directory over HTTP.
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760

# Session lifetime (days)
SESSION_TTL_DAYS=30

# Development convenience: return verification/reset links in API responses.
# MUST remain false in production.
AUTH_DEV_EXPOSE_TOKENS=false

# Seed a demo organization with clearly-labelled sample data.
SEED_DEMO_DATA=false
